# Measured-data research and future pipeline source. Never commit the actual key.
# Register yourself at https://explore.openaq.org/register
# The Phase 1 keyless probe does not load this file or use credentials.
OPENAQ_API_KEY=

# Set an explicit, dedicated PostgreSQL 15+ database before running db commands.
# This example uses a local Unix socket and the current OS database role.
DATABASE_URL=postgresql+psycopg:///vietnam_environment

# Optional future Supabase browser/dashboard configuration. The ingestion backend
# does not need either Supabase API key when it uses DATABASE_URL directly.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# For Supabase, paste the Session Pooler URI from Dashboard > Connect into your
# ignored .env, change postgresql:// to postgresql+psycopg://, and append
# ?sslmode=require if it has no query string. Never place its password here.
